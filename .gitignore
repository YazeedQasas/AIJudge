# ---- Python (backend) ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Secrets / environment ----
.env
.env.*
!.env.example

# ---- Node / Angular (frontend also has its own .gitignore) ----
node_modules/
dist/
/frontend/.angular/cache

# ---- Editor / OS junk ----
.DS_Store
Thumbs.db
*.stackdump

# ---- Training subsystem (LoRA) - large downloads/builds, never committed ----
backend/.venv-train/
backend/.hf-cache/
backend/.pip-cache/
backend/training/runs/
backend/training/tools/
*.gguf
*.safetensors

# Raw/unreviewed dataset artifacts - the reviewed {train,val,manifest}.* files
# ARE committed (see training/README.md); these are the noisy pool before review.
backend/training/data/*/drafts.jsonl
backend/training/data/*/auto_rejected.*.jsonl
backend/training/data/*/expanded_questions.yaml
backend/training/data/*/expanded_declined_questions.yaml
